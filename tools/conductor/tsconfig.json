{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node runs these files as they are, stripping the types (ADR-0075): only syntax it can erase,
    // and imports that name the `.ts` file Node will load.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
