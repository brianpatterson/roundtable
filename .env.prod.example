# Production settings. On the server this file is /opt/interview-app/.env, created once by
# deploy/init-env.sh (mode 640, group docker). Never commit the real one.

DOMAIN=example.com
# Where Postgres data and TLS certificates live: the attached DigitalOcean volume.
DATA_DIR=/srv/data

# openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Resend API key, sending access to mail.<DOMAIN> only. Required: the API won't start without it.
# Emails are sent from no-reply@mail.<DOMAIN> (EMAIL_FROM in compose.prod.yml).
RESEND_API_KEY=
# Sentry DSN for error tracking (optional, but production should have it). ADR-0019.
SENTRY_DSN=

# Optional: raise the daily email cap after upgrading Resend (default 80; free plan allows 100/day).
# EMAIL_LIMIT_PER_DAY=80

# "Report a problem" (ADR-0038). Optional: without the GitHub App, reports are stored and emailed
# but no GitHub issue is opened. The App is installed on this repository only, with Issues
# read/write and nothing else, so its issues are authored by its bot, not the owner
# (infra/README.md → "Problem reports"). All three or none; the private key on one line, its
# newlines written as \n, in single quotes (deploy.sh sources this file with bash). Reports
# open issues in GITHUB_ISSUES_REPOSITORY (set in compose.prod.yml) and are emailed to
# REPORTS_EMAIL.
GITHUB_ISSUES_APP_ID=
GITHUB_ISSUES_INSTALLATION_ID=
GITHUB_ISSUES_PRIVATE_KEY=
REPORTS_EMAIL=
# Optional: report issues and emails per 24 hours (default 20).
# REPORT_LIMIT_PER_DAY=20

# API_IMAGE / WEB_IMAGE are set per deploy by deploy/deploy.sh (git-SHA tags), not here.

# OAuth apps registered for https://<DOMAIN>. Callback: https://<DOMAIN>/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
