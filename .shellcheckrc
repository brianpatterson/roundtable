# ShellCheck, for every *.sh and every workflow `run:` script (through actionlint). CI runs both.
# Three notes are off because they flag this repo's idioms, not bugs:
#
# SC2015: `check && pass || fail`. The tests read this way on purpose: `fail` runs when either
#   half fails, which is what a test wants.
disable=SC2015
# SC2016: single-quoted `$` and backticks. Those are jq filters and Markdown, meant literally.
disable=SC2016
# SC2119: calling a function with optional arguments (testlib.sh's `fake_gh`) without any.
disable=SC2119
