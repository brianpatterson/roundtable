# Production edge: TLS (automatic Let's Encrypt), static SPA, and /api reverse proxy.
# DOMAIN comes from the environment (see compose.prod.yml).

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		# The API's own limit (MAX_REQUEST_BODY_BYTES in apps/api/src/platform/http/body-limit.ts),
		# applied here first so a larger body never reaches it: 413.
		request_body {
			max_size 256KiB
		}
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		# Vite fingerprints asset filenames, so they can be cached forever. Everything else, index.html
		# served for any page's path included, must not be: a stale one points at assets a deploy removed.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
