{
  "name": "@roundtable/api",
  "private": true,
  "type": "module",
  "imports": {
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "node build.ts",
    "start": "node --env-file=../../.env --enable-source-maps dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@effect/sql-pg": "4.1.4",
    "@roundtable/contract": "workspace:*",
    "@sentry/node": "^11.15.0",
    "better-auth": "^1.7.26",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  }
}
